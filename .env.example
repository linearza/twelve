# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: Claude API key (https://platform.claude.com/settings/keys).
# Leave empty to use your local Claude Code login instead.
ANTHROPIC_API_KEY=

# Optional: one narrator voice for every style (skips designing a voice per style)
ELEVENLABS_VOICE_ID=
# Optional: set to 1 on a paid ElevenLabs plan to compose a real score with the Music API
ELEVENLABS_MUSIC=
# Optional: parallel ElevenLabs requests (free plan allows 2)
ELEVENLABS_CONCURRENCY=
# Optional: bold .ttf for the title card if none of the defaults exist
FONT_FILE=
